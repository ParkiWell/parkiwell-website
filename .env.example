# The launch list writes to the same Supabase project the app uses.
# Apply supabase/launch_list.sql there first, then set these in Vercel
# (Production and Preview) or in .env.local for development.
#
# The anon key is correct here. The policies in supabase/launch_list.sql give
# that role insert on one table and nothing else, so it cannot read the list.
# Never put the service role key in this file or in the project's environment.
#
# With these unset the form reports that it is unavailable and points at the
# email address instead, which is the intended behaviour for a preview build.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
