# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files, including the .env.example template. None of them is committed.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-cli/

# local diagnostics: screenshots and recordings made while checking a change
/artifacts/
/output/

# Working notes. Kept locally so the knowledge survives, out of the repository
# so the public history is the site and nothing else.
AGENTS.md
CLAUDE.md
docs/DEPLOYING.md
docs/seo.md
